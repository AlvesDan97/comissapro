# Comiss — variáveis de ambiente
# Copie para .env no Backend (local) ou configure no Railway

NODE_ENV=production
PORT=3847

# OBRIGATÓRIO em produção (mín. 24 caracteres)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-aqui
JWT_EXPIRES_IN=7d

# Postgres (Railway): cole a DATABASE_URL do serviço Postgres
# Ex.: postgresql://user:pass@host:5432/railway
DATABASE_URL=

# Railway Postgres costuma precisar de SSL
DATABASE_SSL=true

# Pool de conexões (500 usuários: 10–20 é um bom começo)
DB_POOL_MAX=20

# Domínios permitidos no CORS (separados por vírgula)
# Ex.: https://comiss.com.br,https://www.comiss.com.br
CORS_ORIGINS=

# Rate limits
RATE_LIMIT_LOGIN=30
RATE_LIMIT_API=180

# Asaas
# Sandbox: https://api-sandbox.asaas.com
# Produção: https://api.asaas.com
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=

# URL pública do app (convites, reset, webhook)
APP_URL=https://www.comiss.com.br

# Resend — e-mail transacional (convite, senha, pendências)
# Crie em https://resend.com/api-keys  |  domínio em https://resend.com/domains
RESEND_API_KEY=
MAIL_FROM=Comiss <noreply@comiss.com.br>
