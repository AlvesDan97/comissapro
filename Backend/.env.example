# ComissaPro — variáveis de ambiente
# Copie para .env no Backend (local) ou configure no Railway

NODE_ENV=production
PORT=3847

# OBRIGATÓRIO em produção (mín. 24 caracteres)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-aqui
JWT_EXPIRES_IN=7d

# Postgres (Railway): cole a DATABASE_URL do serviço Postgres
# Ex.: postgresql://user:pass@host:5432/railway
DATABASE_URL=

# Railway Postgres costuma precisar de SSL
DATABASE_SSL=true

# Pool de conexões (500 usuários: 10–20 é um bom começo)
DB_POOL_MAX=20

# Domínios permitidos no CORS (separados por vírgula)
# Ex.: https://comissapro.com.br,https://www.comissapro.com.br
CORS_ORIGINS=

# Rate limits
RATE_LIMIT_LOGIN=30
RATE_LIMIT_API=180

# Asaas (próxima etapa)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
